# Copy to .env and adjust. Never commit .env.
# No secrets are needed yet; this file grows as milestones add settings.

# Backend
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173
# Upload limit for /predict/audio (used from M4).
MAX_UPLOAD_MB=5
# Path to the deployed model artifact (used from M4). Empty = default in backend/models/.
MODEL_PATH=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
