# Copy to .env and adjust. Never commit .env.
# No secrets are needed yet; this file grows as milestones add settings.

# Backend
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173
# Upload limit for /predict/audio.
MAX_UPLOAD_MB=5
# Directory with model.joblib + model_metadata.json. Empty = backend/models/.
MODEL_PATH=
# Prediction requests per client IP per minute (0 = no limit).
RATE_LIMIT_PER_MINUTE=10
# Trusted reverse proxies in front of the API (0 locally; 1 on Hugging Face Spaces).
FORWARDED_HOPS=0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
